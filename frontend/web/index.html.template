<!DOCTYPE html>
<html>
<head>
  <!--
    If you are serving your web app in a path other than the root, change the
    href value below to reflect the base path you are serving from.

    The path provided below has to start and end with a slash "/" in order for
    it to work correctly.

    For more details:
    * https://developer.mozilla.org/en-US/docs/Web/HTML/Element/base

    This is a placeholder for base href that will be replaced by the value of
    the `--base-href` argument provided to `flutter build`.
  -->
  <base href="$FLUTTER_BASE_HREF">

  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="description" content="A new Flutter project.">

  <!-- iOS meta tags & icons -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="apple-mobile-web-app-title" content="frontend">
  <link rel="apple-touch-icon" href="icons/Icon-192.png">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="favicon.png"/>

  <title>SafeWay</title>
  <link rel="manifest" href="manifest.json">

  <!--
    ======================================================
    【Web テスト用 Google Maps API キーの設定方法】
    ======================================================
    このファイル（index.html）はローカル専用で Git 管理外です。
    
    1. このファイルを直接編集して、以下の YOUR_GOOGLE_MAPS_API_KEY_HERE を
       実際の API キーに置き換えてください。
    2. このファイルは .gitignore に登録されているため、
       編集内容が Git にコミット・プッシュされることは絶対にありません。
    3. 他の開発者は index.html.template をコピーしてこのファイルを作成してください。
    ======================================================
  -->
  <!-- Google Maps JavaScript SDK (Web) -->
  <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY_HERE"></script>
  <script>
    // Google Maps の初期化時に割り込み、POIのクリック（情報ポップアップ）を無効化する
    (function() {
      var checkInterval = setInterval(function() {
        if (window.google && window.google.maps) {
          clearInterval(checkInterval);
          var OriginalMap = google.maps.Map;
          google.maps.Map = function(element, options) {
            options = options || {};
            // clickableIcons: false により、POIをクリックした際の
            // デフォルトインフォウィンドウ（「Googleマップで見る」等）の表示を無効化します。
            options.clickableIcons = false;
            return new OriginalMap(element, options);
          };
          google.maps.Map.prototype = OriginalMap.prototype;
        }
      }, 50);
    })();
  </script>
</head>
<body>
  <!--
    You can customize the "flutter_bootstrap.js" script.
    This is useful to provide a custom configuration to the Flutter loader
    or to give the user feedback during the initialization process.

    For more details:
    * https://docs.flutter.dev/platform-integration/web/initialization
  -->
  <script src="flutter_bootstrap.js" async></script>
</body>
</html>
